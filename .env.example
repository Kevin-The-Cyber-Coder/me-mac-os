# ─────────────────────────────────────────────────────────────
# KEVIN THE CYBER CODER — ENVIRONMENT TEMPLATE
# Copy to .env and fill in. NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Public URL of the API (used for unsubscribe links in emails)
PUBLIC_API_URL=http://localhost:5000
# Comma separated list of extra allowed origins (production frontend)
ALLOWED_ORIGINS=

# Database (MongoDB Atlas or local). If omitted the API runs in
# in-memory demo mode so the portfolio remains browsable.
MONGODB_URI=

# Authentication — generate long random values, e.g. `openssl rand -hex 48`
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Used to encrypt secrets stored by the admin panel (AES-256-GCM)
SETTINGS_SECRET=change-me-settings-encryption-key

# Bootstrap administrator (created by `npm run seed` if missing)
ADMIN_NAME=Mukeshimana Kevin
ADMIN_EMAIL=admin@kevinthecybercoder.dev
ADMIN_PASSWORD=CyberCoder#2026

# Email (Nodemailer / SMTP). Leave empty to log emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kevin The Cyber Coder <no-reply@kevinthecybercoder.dev>"
ADMIN_NOTIFY_EMAIL=admin@kevinthecybercoder.dev

# Cloudinary (optional — local disk uploads are used when absent)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kevin-cyber-portfolio

# AI — ARENA AI (OpenAI-compatible providers work out of the box)
# Provider may also be configured from the admin panel. Keys set here
# take precedence and are never sent to the browser.
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.7
AI_DAILY_MESSAGE_LIMIT=60
AI_RETENTION_DAYS=30

# GitHub integration (fine-grained PAT with public read scope)
GITHUB_TOKEN=
GITHUB_USERNAME=kevinthecybercoder
GITHUB_CACHE_TTL_SECONDS=600

# Optional GitHub OAuth app (for the admin "Connect GitHub" flow)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT=http://localhost:5000/api/github/oauth/callback

# Analytics
ANALYTICS_SALT=change-me-analytics-salt

# Client (Vite) — leave empty to use the dev proxy / same-origin API
VITE_API_URL=
VITE_SITE_URL=http://localhost:5173
